rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /songs/{songId} {
      allow read: if true;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['sung', 'sungAt', 'sungBy']);
      allow create, delete: if false;
    }
  }
}
