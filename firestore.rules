rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasOnlyMutableSongKeys() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(['sung', 'sungAt', 'sungBy']);
    }

    function hasValidSongState() {
      return request.resource.data.sung is bool
        && (request.resource.data.sungAt == null || request.resource.data.sungAt is string)
        && request.resource.data.sungBy is list
        && request.resource.data.sungBy.size() <= 20
        && (
          request.resource.data.sung
            ? request.resource.data.sungAt != null
            : request.resource.data.sungAt == null
        );
    }

    match /songs/{songId} {
      allow read: if true;
      allow update: if request.auth != null
        && hasOnlyMutableSongKeys()
        && hasValidSongState();
      allow create, delete: if false;
    }

    match /series/{seriesId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
  }
}
