{
  "name": "sentai-50th-song-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "npm run local:start",
    "start:fresh": "npm run local:start:fresh",
    "release": "npm run deploy:all:prod",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "data:convert": "node scripts/convert-csv.mjs",
    "data:enrich:readings": "node scripts/enrich-readings.mjs data/songs.json data/songs.json",
    "data:readings:apply:if-exists": "if [ -f data/reading-tasks.json ]; then npm run data:readings:apply; else echo \"skip: data/reading-tasks.json not found\"; fi",
    "data:convert:official": "node scripts/convert-csv.mjs data/戦隊カラオケリスト.csv data/songs.json && npm run data:enrich:readings && npm run data:readings:apply:if-exists",
    "data:readings:extract": "node scripts/extract-reading-tasks.mjs data/songs.json data/reading-tasks.json data/reading-tasks.prompt.txt",
    "data:readings:apply": "node scripts/apply-reading-tasks.mjs data/songs.json data/reading-tasks.json data/songs.json",
    "data:check": "node scripts/check-data.mjs data/songs.json",
    "check:all": "npm run lint && npm test && npm run build && npm run data:check",
    "emulator:start": "firebase emulators:start --project sentai-50th-song-tracker --only firestore,auth",
    "firestore:seed:local": "FIREBASE_PROJECT_ID=sentai-50th-song-tracker FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/upload-to-firestore.mjs data/songs.json",
    "firestore:seed:local:dry-run": "FIREBASE_PROJECT_ID=sentai-50th-song-tracker FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/upload-to-firestore.mjs data/songs.json --dry-run",
    "firestore:seed:prod": "FIREBASE_PROJECT_ID=sentai-50th-song-tracker node scripts/upload-to-firestore.mjs data/songs.json",
    "firestore:seed:prod:dry-run": "FIREBASE_PROJECT_ID=sentai-50th-song-tracker node scripts/upload-to-firestore.mjs data/songs.json --dry-run",
    "deploy:data:prod": "npm run data:convert:official && npm run data:check && npm run firestore:seed:prod",
    "deploy:app:prod": "npm run build && firebase deploy --project prod --only hosting,firestore:rules",
    "deploy:all:prod": "npm run check:all && npm run deploy:data:prod && npm run deploy:app:prod",
    "local:prepare": "npm run data:convert:official && npm run data:check && npm run firestore:seed:local",
    "local:start": "VITE_USE_FIREBASE_EMULATOR=true npm run dev -- --host",
    "local:start:fresh": "npm run local:prepare && npm run local:start",
    "firebase:config:to-env": "node scripts/firebase-config-to-env.mjs",
    "firestore:seed": "npm run firestore:seed:prod",
    "firestore:seed:dry-run": "npm run firestore:seed:prod:dry-run",
    "test": "node --test"
  },
  "dependencies": {
    "firebase": "^12.9.0",
    "firebase-admin": "^13.5.0",
    "fuse.js": "^7.1.0",
    "kuromoji": "^0.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1"
  }
}
