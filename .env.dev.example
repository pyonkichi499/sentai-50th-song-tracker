# Firebase Cloud (development project) connection for local app run
# Usage:
# 1) Create a Firebase project for development (example: sentai-50th-song-tracker-dev)
# 2) Copy this file to `.env.dev.local` and fill values from Firebase Console > Project settings > Your apps > Web app
# 3) Run `vite --mode dev` or use `npm run start:dev`

VITE_DATA_SOURCE=firestore

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_V3_SITE_KEY=

# Connect to Firebase Cloud (not local emulator)
VITE_USE_FIREBASE_EMULATOR=false

# These are ignored when VITE_USE_FIREBASE_EMULATOR=false, but kept for clarity
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_AUTH_EMULATOR_HOST=127.0.0.1
VITE_AUTH_EMULATOR_PORT=9099
